# Telegram API (collector)
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# PostgreSQL (storage)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telegram_exchange
DB_USER=postgres
DB_PASSWORD=

# Redis (jobs)
REDIS_URL=redis://localhost:6379/0

# Rate limiting (jobs)
TELEGRAM_RATE_LIMIT=20/s

# OpenRouter API (novelty scoring)
OPENROUTER_API_KEY=

# Ranking (v3/v4 formula)
# Weight for novelty in v3/v4: 3=balanced, 5=default, 7-10=novelty-focused
NOVELTY_WEIGHT=5
# Baseline for frequency penalty in v4: lower = stricter penalty
AVG_POSTS_PER_DAY=5

# API (optional)
APP_ENV=dev  # dev|test|prod
ENABLE_DEV_LOGIN=false
JWT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_TTL_SECONDS=86400
TELEGRAM_AUTH_CLOCK_SKEW_SECONDS=60

# CORS
# Comma-separated origins, or "*" to allow all (credentials will be disabled when using "*")
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Admin access (comma-separated user IDs or "all" for dev mode)
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=all

# Umami Analytics (optional, monitoring profile)
UMAMI_APP_SECRET=
